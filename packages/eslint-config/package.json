{
    "name": "@terascope/eslint-config",
    "displayName": "Terascope ESLint Config",
    "version": "1.4.1",
    "description": "A shared eslint config based on eslint-config-airbnb",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/eslint-config#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": "git@github.com:terascope/teraslice.git",
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "index.js",
    "files": [
        "index.js",
        "lib/**/*"
    ],
    "scripts": {
        "test": "node ../scripts/bin/ts-scripts test ../eslint-config --",
        "test:debug": "node ../scripts/bin/ts-scripts test --debug ../eslint-config --",
        "test:watch": "node ../scripts/bin/ts-scripts test --watch ../eslint-config --"
    },
    "dependencies": {
        "@eslint/compat": "catalog:",
        "@eslint/js": "catalog:",
        "@stylistic/eslint-plugin": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-import": "catalog:",
        "eslint-plugin-jest": "catalog:",
        "eslint-plugin-jest-dom": "catalog:",
        "eslint-plugin-jsx-a11y": "catalog:",
        "eslint-plugin-react": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-testing-library": "catalog:",
        "globals": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:"
    },
    "devDependencies": {
        "jest-extended": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "terascope": {
        "enableTypedoc": false,
        "testSuite": "unit"
    }
}
