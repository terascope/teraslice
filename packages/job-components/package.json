{
    "name": "@terascope/job-components",
    "displayName": "Job Components",
    "version": "2.19.2",
    "description": "A teraslice library for validating jobs schemas, registering apis, and defining and running new Job APIs",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/job-components#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/terascope/teraslice.git"
    },
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "directories": {
        "lib": "dist/src",
        "test": "test"
    },
    "files": [
        "dist/src/**/*"
    ],
    "scripts": {
        "benchmark": " pnpm build && node bench/index.js",
        "build": "tsc --build",
        "build:watch": "pnpm build --watch",
        "test": "node ../scripts/bin/ts-scripts test ../job-components --",
        "test:debug": "node ../scripts/bin/ts-scripts test --debug ../job-components --",
        "test:watch": "node ../scripts/bin/ts-scripts test --watch ../job-components --"
    },
    "dependencies": {
        "@terascope/core-utils": "workspace:~",
        "@terascope/types": "workspace:~",
        "import-meta-resolve": "catalog:",
        "prom-client": "catalog:",
        "semver": "catalog:",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@jest/globals": "catalog:",
        "@types/semver": "catalog:",
        "benchmark": "catalog:",
        "fs-extra": "catalog:",
        "jest-extended": "catalog:",
        "jest-fixtures": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "srcMain": "src/index.ts",
    "terascope": {
        "enableTypedoc": true,
        "testSuite": "unit"
    }
}
