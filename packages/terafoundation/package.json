{
    "name": "terafoundation",
    "displayName": "Terafoundation",
    "version": "2.19.1",
    "description": "A Clustering and Foundation tool for Terascope Tools",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/terafoundation#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": "git@github.com:terascope/teraslice.git",
    "license": "Apache-2.0",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "directories": {
        "lib": "dist/src",
        "test": "test"
    },
    "files": [
        "dist/src/**/*"
    ],
    "scripts": {
        "build": "tsc --build",
        "build:watch": "pnpm build --watch",
        "test": "node ../scripts/bin/ts-scripts test ../terafoundation --",
        "test:debug": "node ../scripts/bin/ts-scripts test --debug ../terafoundation --",
        "test:watch": "node ../scripts/bin/ts-scripts test --watch ../terafoundation --"
    },
    "dependencies": {
        "@terascope/core-utils": "workspace:~",
        "@terascope/file-asset-apis": "catalog:",
        "@terascope/opensearch-client": "workspace:~",
        "@terascope/types": "workspace:~",
        "bunyan": "catalog:",
        "express": "catalog:",
        "js-yaml": "catalog:",
        "nanoid": "catalog:",
        "prom-client": "catalog:",
        "yargs": "catalog:"
    },
    "devDependencies": {
        "@jest/globals": "catalog:",
        "@types/bunyan": "catalog:",
        "@types/express": "catalog:",
        "@types/js-yaml": "catalog:",
        "@types/yargs": "catalog:",
        "got": "catalog:",
        "jest-extended": "catalog:"
    },
    "peerDependencies": {
        "@terascope/valkey": "workspace:~",
        "terafoundation_kafka_connector": "catalog:"
    },
    "peerDependenciesMeta": {
        "@terascope/valkey": {
            "optional": true
        },
        "terafoundation_kafka_connector": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "terascope": {
        "enableTypedoc": true,
        "testSuite": "unit"
    }
}
