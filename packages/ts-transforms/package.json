{
    "name": "ts-transforms",
    "displayName": "TS Transforms",
    "version": "2.18.1",
    "description": "An ETL framework built upon xlucene-evaluator",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/ts-transforms#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/terascope/teraslice.git"
    },
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "bin": {
        "ts-match": "./bin/ts-transform.js",
        "ts-transform": "./bin/ts-transform.js"
    },
    "directories": {
        "lib": "dist/src",
        "test": "test"
    },
    "files": [
        "dist/src/**/*",
        "bin/*"
    ],
    "scripts": {
        "build": "tsc --build",
        "build:watch": "pnpm build --watch",
        "test": "node ../scripts/bin/ts-scripts test ../ts-transforms --",
        "test:debug": "node ../scripts/bin/ts-scripts test --debug ../ts-transforms --",
        "test:watch": "node ../scripts/bin/ts-scripts test --watch ../ts-transforms --"
    },
    "dependencies": {
        "@terascope/core-utils": "workspace:~",
        "@terascope/data-mate": "workspace:~",
        "@terascope/ip-utils": "workspace:~",
        "@terascope/types": "workspace:~",
        "awesome-phonenumber": "catalog:",
        "graphlib": "catalog:",
        "jexl": "catalog:",
        "nanoid": "catalog:",
        "valid-url": "catalog:",
        "validator": "catalog:",
        "yargs": "catalog:"
    },
    "devDependencies": {
        "@jest/globals": "catalog:",
        "@types/graphlib": "catalog:",
        "@types/jexl": "catalog:",
        "@types/valid-url": "catalog:",
        "@types/validator": "catalog:",
        "@types/yargs": "catalog:",
        "execa": "catalog:",
        "jest-extended": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "srcMain": "src/index.ts",
    "terascope": {
        "enableTypedoc": true,
        "testSuite": "unit"
    }
}
