{
    "name": "teraslice-cli",
    "displayName": "Teraslice CLI",
    "version": "3.2.0",
    "description": "Command line manager for teraslice jobs, assets, and cluster references.",
    "keywords": [
        "teraslice"
    ],
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/teraslice-cli#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": "git@github.com:terascope/teraslice.git",
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/ts-cli.js",
    "bin": {
        "earl": "bin/teraslice-cli.js",
        "teraslice-cli": "bin/teraslice-cli.js"
    },
    "directories": {
        "lib": "dist/src",
        "test": "test"
    },
    "files": [
        "bin/**/*",
        "generator-templates/**/*",
        "dist/src/ts-cli.js",
        "dist/src/helpers/esm-shims.js"
    ],
    "scripts": {
        "build": "tsc --build && pnpm postbuild",
        "postbuild": "node build.js",
        "build:watch": "tsc --build --watch & node build.js --watch",
        "test": "node ../scripts/bin/ts-scripts test ../teraslice-cli --",
        "test:debug": "ts-scripts test --debug . --",
        "test:watch": "ts-scripts test --watch . --"
    },
    "dependencies": {
        "esbuild": "catalog:"
    },
    "devDependencies": {
        "@jest/globals": "catalog:",
        "@terascope/core-utils": "workspace:~",
        "@terascope/fetch-github-release": "catalog:",
        "@terascope/types": "workspace:~",
        "@types/decompress": "catalog:",
        "@types/ejs": "catalog:",
        "@types/js-yaml": "catalog:",
        "@types/prompts": "catalog:",
        "@types/signale": "catalog:",
        "@types/tmp": "catalog:",
        "@types/yargs": "catalog:",
        "chalk": "catalog:",
        "cli-table3": "catalog:",
        "decompress": "catalog:",
        "diff": "catalog:",
        "easy-table": "catalog:",
        "ejs": "catalog:",
        "execa": "catalog:",
        "fs-extra": "catalog:",
        "globby": "catalog:",
        "jest-extended": "catalog:",
        "jest-fixtures": "catalog:",
        "js-yaml": "catalog:",
        "nock": "catalog:",
        "pretty-bytes": "catalog:",
        "prompts": "catalog:",
        "signale": "catalog:",
        "teraslice-client-js": "workspace:~",
        "tmp": "catalog:",
        "tty-table": "catalog:",
        "uuid": "catalog:",
        "yargs": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "pkg": {
        "scripts": "cmds/**/*.js",
        "assets": [
            "package.json",
            "generators-templates/**/*"
        ]
    },
    "terascope": {
        "testSuite": "unit",
        "enableTypedoc": true
    }
}
