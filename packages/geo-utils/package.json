{
    "name": "@terascope/geo-utils",
    "displayName": "Geo Utils",
    "version": "2.17.2",
    "description": "A collection of Teraslice Geo Utilities",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/geo-utils#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": "git@github.com:terascope/teraslice.git",
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "sideEffects": false,
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "files": [
        "dist/src/**/*"
    ],
    "scripts": {
        "build": "tsc --build",
        "build:watch": "pnpm build --watch",
        "test": "node ../scripts/bin/ts-scripts test ../geo-utils --",
        "test:debug": "node ../scripts/bin/ts-scripts test --debug ../geo-utils --",
        "test:watch": "node ../scripts/bin/ts-scripts test --watch ../geo-utils --"
    },
    "dependencies": {
        "@terascope/core-utils": "workspace:~",
        "@terascope/types": "workspace:~",
        "@turf/bbox": "catalog:",
        "@turf/bbox-polygon": "catalog:",
        "@turf/boolean-contains": "catalog:",
        "@turf/boolean-disjoint": "catalog:",
        "@turf/boolean-equal": "catalog:",
        "@turf/boolean-intersects": "catalog:",
        "@turf/boolean-point-in-polygon": "catalog:",
        "@turf/boolean-within": "catalog:",
        "@turf/circle": "catalog:",
        "@turf/helpers": "catalog:",
        "@turf/invariant": "catalog:",
        "@turf/line-to-polygon": "catalog:",
        "geo-tz": "catalog:",
        "latlon-geohash": "catalog:"
    },
    "devDependencies": {
        "@types/geojson": "catalog:",
        "jest-extended": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "srcMain": "src/index.ts",
    "terascope": {
        "enableTypedoc": true,
        "testSuite": "unit"
    }
}
