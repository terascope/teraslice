# Values for the rook-release/rook-ceph (operator) chart.
# Rendered by helmfile from packages/scripts/helm/values.yaml (.Values.ceph.*).
#
# The one setting that matters for kind: allowLoopDevices. Ceph on a kind node
# has no spare raw disk, so kind.ts backs the OSD with a loop device. This is
# the declarative version of the manual `kubectl patch cm rook-ceph-operator-config`
# (ROOK_CEPH_ALLOW_LOOP_DEVICES) step -- the chart writes that ConfigMap for us.
allowLoopDevices: true

# We only use object storage (RGW), never block/filesystem PVCs, so the CSI
# drivers are pure overhead on a single test node. Skip the ceph-csi operator.
csi:
  installCsiOperator: false

# No raw-disk discovery needed; the OSD device is named explicitly.
enableDiscoveryDaemon: false

# Trim the operator footprint for a local single-node cluster.
resources:
  limits:
    memory: 512Mi
  requests:
    cpu: 100m
    memory: 128Mi
