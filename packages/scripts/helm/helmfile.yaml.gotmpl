environments:
  default:
    values:
      - values.yaml
---

repositories:
  - name: terascope
    url: https://terascope.github.io/helm-charts/
  - name: opensearch
    url: https://opensearch-project.github.io/helm-charts/
  - name: minio
    url: https://charts.min.io/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: kafka-ui
    url: https://provectus.github.io/kafka-ui-charts/
  - name: chaos-mesh
    url: https://charts.chaos-mesh.org
  - name: valkey
    url: https://valkey.io/valkey-helm/
  - name: rook-release
    url: https://charts.rook.io/release

helmDefaults:
  wait: true

releases:
  - name: namespaces
    namespace: default
    chart: ./namespaces
    version: 0.1.0

  - name: stern
    namespace: default
    chart: ./stern
    version: 0.1.0
    needs:
      - default/namespaces
    installed: {{ .Values | get "stern.enabled" false }}
    values:
      - ./templates/stern.yaml.gotmpl

  - name: minio-secret
    namespace: default
    chart: ./minio-secret
    version: 0.1.0
    needs:
      - default/namespaces
    installed: {{ and (.Values | get "minio.enabled" false) (.Values | get "minio.tls.enabled" false) }}
    values:
      - ./templates/minio-secret.yaml.gotmpl

  # Holds the RGW TLS keypair (opaque secret, "cert" key). Rook's CephObjectStore
  # sslCertificateRef points at it. Gated on ceph TLS; values inlined from ceph.tls.
  - name: ceph-secret
    namespace: rook-ceph
    chart: ./ceph-secret
    version: 0.1.0
    needs:
      - default/namespaces
    installed: {{ and (.Values | get "ceph.enabled" false) (.Values | get "ceph.tls.enabled" false) }}
    values:
      - secretName: {{ .Values | get "ceph.tls.certSecret" "tls-ssl-ceph" }}
        namespace: {{ .Values | get "ceph.namespace" "rook-ceph" }}
        keypair: {{ .Values | get "ceph.tls.keypair" "" | quote }}

  - name: opensearch1
    namespace: services-dev1
    chart: opensearch/opensearch
    version: 2.17.1
    installed: {{ .Values | get "opensearch1.enabled" false }}
    values:
      - ./templates/os1.yaml.gotmpl
    labels:
      app: opensearch1
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: opensearch2
    namespace: services-dev1
    chart: opensearch/opensearch
    version: 2.31.0
    installed: {{ .Values | get "opensearch2.enabled" true }}
    values:
      - ./templates/os2.yaml.gotmpl
    labels:
      app: opensearch2
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: opensearch3
    namespace: services-dev1
    chart: opensearch/opensearch
    version: 3.1.0
    installed: {{ .Values | get "opensearch3.enabled" false }}
    values:
      - ./templates/os3.yaml.gotmpl
    labels:
      app: opensearch3
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: minio
    namespace: services-dev1
    chart: minio/minio
    version: 5.3.0
    installed: {{ .Values | get "minio.enabled" false }}
    values:
      - ./templates/minio.yaml.gotmpl
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}
    {{- if .Values | get "minio.tls.enabled" false }}
      - default/minio-secret
    {{- end }}

  # Ceph (Rook) S3 object store: the operator, the CephCluster/CephObjectStore,
  # and ceph-extras (RGW NodePort + a static-keyed S3 user). All gated on
  # ceph.enabled. kind.ts preps the node's OSD loop device before these reconcile.
  - name: rook-ceph
    namespace: rook-ceph
    chart: rook-release/rook-ceph
    version: {{ .Values | get "ceph.operatorVersion" "v1.20.7" }}
    installed: {{ .Values | get "ceph.enabled" false }}
    values:
      - ./templates/ceph-operator.yaml.gotmpl
    needs:
      - default/namespaces

  - name: rook-ceph-cluster
    namespace: rook-ceph
    chart: rook-release/rook-ceph-cluster
    version: {{ .Values | get "ceph.operatorVersion" "v1.20.7" }}
    installed: {{ .Values | get "ceph.enabled" false }}
    # The OSD/RGW come up via operator reconcile, not this release's workloads, so
    # a helm --wait would just block on the toolbox and risk a timeout.
    wait: false
    values:
      - ./templates/ceph-cluster.yaml.gotmpl
    needs:
      - default/namespaces
      - rook-ceph/rook-ceph
    {{- if .Values | get "ceph.tls.enabled" false }}
      # The CephObjectStore's sslCertificateRef points at this secret, so it must
      # exist before the cluster reconciles.
      - rook-ceph/ceph-secret
    {{- end }}

  # RGW NodePort (host access) + a static-keyed S3 user (Secret +
  # CephObjectStoreUser). Values inlined from the shared ceph.* config.
  - name: ceph-extras
    namespace: rook-ceph
    chart: ./ceph-extras
    version: 0.1.0
    installed: {{ .Values | get "ceph.enabled" false }}
    values:
      - namespace: {{ .Values | get "ceph.namespace" "rook-ceph" }}
        storeName: {{ .Values | get "ceph.storeName" "teraslice-store" }}
        rgwPort: {{ .Values | get "ceph.rgwPort" 80 }}
        nodePort: {{ .Values | get "ceph.nodePort" 30902 }}
        user: {{ .Values | get "ceph.user" "test" }}
        accessKey: {{ .Values | get "ceph.accessKey" "cephtestaccesskey" }}
        secretKey: {{ .Values | get "ceph.secretKey" "cephtestsecretkey" }}
        dashboardEnabled: {{ .Values | get "ceph.dashboard.enabled" false }}
        dashboardNodePort: 30903
    needs:
      - rook-ceph/rook-ceph
      - rook-ceph/rook-ceph-cluster
    # Wait for the operator to actually provision the S3 user; teraslice `needs`
    # this release so it won't start until the user (and RGW) is Ready.
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - "-n"
          - "{{ .Values | get "ceph.namespace" "rook-ceph" }}"
          - "wait"
          - "--for=jsonpath={.status.phase}=Ready"
          - "cephobjectstoreuser/{{ .Values | get "ceph.user" "test" }}"
          - "--timeout=300s"

  - name: kafka
    namespace: services-dev1
    chart: terascope/kafka
    version: 1.3.0
    installed: {{ .Values | get "kafka.enabled" true }}
    values:
      - ./templates/kafka.yaml.gotmpl
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: kafka-ui
    namespace: services-dev1
    chart: kafka-ui/kafka-ui
    needs:
      - default/namespaces
      - services-dev1/kafka
    version: 0.7.6
    installed: {{ .Values | get "kafka-ui.enabled" true }}
    values:
      - ./templates/kafka-ui.yaml.gotmpl

  - name: utility
    namespace: services-dev1
    chart: ./utility
    version: 0.0.1
    installed: {{ .Values | get "utility.enabled" true }}
    values:
      - ./templates/utility.yaml.gotmpl
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: valkey
    namespace: services-dev1
    chart: valkey/valkey
    version: 0.9.4
    installed: {{ .Values | get "valkey.enabled" true }}
    values:
      - ./templates/valkey.yaml.gotmpl
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: teraslice
    namespace: ts-dev1
    chart: ../../../helm/teraslice
    needs:
      - default/namespaces
      - services-dev1/{{ .Values | get "teraslice.stateCluster" "opensearch2" }}
      {{- if .Values | get "ceph.enabled" false }}
      # Start teraslice only after Ceph's S3 user is Ready (ceph-extras' hook), so
      # its first boot uploads assets to Ceph instead of recording them "missing".
      - rook-ceph/ceph-extras
      {{- end }}
    values:
      - ./templates/teraslice.yaml.gotmpl
    labels:
      app: teraslice

  - name: prometheus-stack
    namespace: services-dev1
    version: 78.4.0
    chart: prometheus-community/kube-prometheus-stack
    installed: {{ .Values | get "prometheus_stack.enabled" false }}
    values:
      - ./templates/prometheus-stack.yaml.gotmpl
    labels:
      app: prom-grafana
      group: skipDiff
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}

  - name: chaos-mesh
    namespace: chaos-mesh
    chart: chaos-mesh/chaos-mesh
    version: 2.7.0
    installed: {{ .Values | get "chaos_mesh.enabled" false }}
    values:
      - chaosDaemon:
          runtime: containerd
          socketPath: /run/containerd/containerd.sock
        dashboard:
          securityMode: false
          service:
            type: NodePort
            nodePort: 30333
        controllerManager:
          replicaCount: 1
    needs:
      - default/namespaces
    {{- if .Values | get "stern.enabled" false }}
      - default/stern
    {{- end }}
