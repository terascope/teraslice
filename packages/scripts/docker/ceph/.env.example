# Example environment for running this stack standalone: `cp .env.example .env`.
#
# Under `ts-scripts test` the .env file is GENERATED from
# packages/scripts/src/helpers/config.ts and overwritten on every run, so edit
# the config defaults (or export the matching CEPH_* var) rather than this file.
#
# These values are used in two different ways:
#   - compose interpolation  -- CEPH_IMAGE and RGW_PORT
#   - `env_file:` injection  -- everything the scripts inside the containers read
# Exporting a var in your shell only covers the first, so a shell override
# changes the published port without changing the port RGW binds to.

CEPH_IMAGE=quay.io/ceph/ceph:v19.2.6

# Same port inside and out, or RGW hands back URLs the client can't reach.
RGW_PORT=47480
S3_ENDPOINT=http://rgw:47480

# Throwaway credentials for a disposable local cluster. Not secrets.
S3_ACCESS_KEY=cephtestaccesskey
S3_SECRET_KEY=cephtestsecretkey
S3_USER=test

# Standalone, increasing this requires adding matching osd1, osd2... service
# blocks alongside osd0 -- compose can't template them. Under `ts-scripts test`
# they are generated into docker-compose.osds.yml instead.
OSD_COUNT=1
OSD_SIZE=10G

# TLS. Off here, and `ts-scripts test` turns it on with ENCRYPT_CEPH='true'.
# Switching it on standalone means merging the overlay too:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# and minting the keypair yourself, since there is no ts-scripts to do it:
#   mkcert -client rgw ceph-rgw localhost
#   cat <key>.pem <cert>.pem > /some/dir/ceph-keypair.pem
#   mkdir -p /some/dir/CAs && cp "$(mkcert -CAROOT)/rootCA.pem" /some/dir/CAs/
# Then set CEPH_CERT_DIR=/some/dir, RGW_SSL=true, and S3_ENDPOINT to https.
# RGW serves TLS *instead of* plaintext, not alongside it.
RGW_SSL=false
# Host path, used by compose to bind mount the certs at /opt/certs.
CEPH_CERT_DIR=
# Container paths, read by rgw.sh and setup.sh.
RGW_SSL_CERT=/opt/certs/ceph-keypair.pem
RGW_SSL_CA=/opt/certs/CAs/rootCA.pem
