# Example environment for running this stack standalone: `cp .env.example .env`.
#
# Under `ts-scripts test` the .env file is GENERATED from
# packages/scripts/src/helpers/config.ts and overwritten on every run, so edit
# the config defaults (or export the matching CEPH_* var) rather than this file.
#
# These values are load-bearing in two different ways and both are needed:
#   - compose interpolation  -- CEPH_IMAGE and RGW_PORT
#   - `env_file:` injection  -- everything the scripts inside the containers read
# Exporting a var in your shell only covers the first, so a shell override
# changes the published port without changing the port RGW binds to.
#
# There is deliberately no subnet or monitor address here: every daemon reads
# its own address at runtime, so docker picks a free range on its own.

CEPH_IMAGE=quay.io/ceph/ceph:v19.2.6

# Same port inside and out, or RGW hands back URLs the client can't reach.
RGW_PORT=49500
S3_ENDPOINT=http://rgw:49500

# Throwaway credentials for a disposable local cluster. Not secrets.
S3_ACCESS_KEY=cephtestaccesskey
S3_SECRET_KEY=cephtestsecretkey
S3_USER=test

# 1 OSD saves ~490 MiB over 3. Going above 1 also requires adding matching osd1,
# osd2... service blocks alongside osd0 -- compose can't template them.
OSD_COUNT=1
OSD_SIZE=10G
