{
    "name": "@terascope/scripts",
    "displayName": "Scripts",
    "version": "2.25.0",
    "description": "A collection of terascope monorepo scripts",
    "homepage": "https://github.com/terascope/teraslice/tree/master/packages/scripts#readme",
    "bugs": {
        "url": "https://github.com/terascope/teraslice/issues"
    },
    "repository": "git@github.com:terascope/teraslice.git",
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "bin": {
        "ts-scripts": "./bin/ts-scripts.js"
    },
    "files": [
        "dist/src/**/*",
        "bin/*",
        "docker/**/*",
        "scripts/**/*"
    ],
    "scripts": {
        "build": "tsc --build",
        "build:watch": "pnpm build --watch",
        "test": "ts-scripts test . --",
        "test:debug": "ts-scripts test --debug . --",
        "test:watch": "ts-scripts test --watch . --"
    },
    "dependencies": {
        "@kubernetes/client-node": "catalog:",
        "@terascope/core-utils": "workspace:~",
        "execa": "catalog:",
        "fs-extra": "catalog:",
        "globby": "catalog:",
        "got": "catalog:",
        "ip": "catalog:",
        "js-yaml": "catalog:",
        "kafkajs": "catalog:",
        "micromatch": "catalog:",
        "mnemonist": "catalog:",
        "ms": "catalog:",
        "nanoid": "catalog:",
        "package-json": "catalog:",
        "package-up": "catalog:",
        "semver": "catalog:",
        "signale": "catalog:",
        "sort-package-json": "catalog:",
        "toposort": "catalog:",
        "typedoc": "catalog:",
        "typedoc-plugin-markdown": "catalog:",
        "yaml": "catalog:",
        "yargs": "catalog:"
    },
    "devDependencies": {
        "@jest/globals": "catalog:",
        "@terascope/types": "workspace:~",
        "@types/ip": "catalog:",
        "@types/js-yaml": "catalog:",
        "@types/micromatch": "catalog:",
        "@types/ms": "catalog:",
        "@types/semver": "catalog:",
        "@types/signale": "catalog:",
        "@types/toposort": "catalog:",
        "@types/yargs": "catalog:",
        "jest-extended": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "srcMain": "src/index.ts",
    "terascope": {
        "enableTypedoc": false,
        "testSuite": "unit"
    }
}
