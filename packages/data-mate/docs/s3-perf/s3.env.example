# =============================================================================
# S3 / Ceph connection + run settings for the DuckFrame performance harness.
#
# The image ships this file to /app/config/s3.env. Edit THAT copy over SSH:
#
#     docker exec -it <container> vi /app/config/s3.env
#
# or mount your own:  docker run --env-file s3.env ...
#
# Defaults below are the LOCAL MINIO settings, so the image works on the Mac
# with no edits. Change the marked block for Ceph.
#
# Every name here maps to a real DuckDB setting, verified against the 1.5.5
# build in this image. `SELECT * FROM duckdb_settings()` lists them all.
# =============================================================================

# ---------------------------------------------------------------- endpoint --
# Host and port ONLY. No scheme — DuckDB adds it based on S3_USE_SSL below.
#   local minio : 127.0.0.1:9000   (or host.docker.internal:9000 from a container)
#   ceph rgw    : rgw.your.domain  (RGW commonly listens on 8080 plain / 8443 TLS,
#                                   NOT 9000 — add the port unless it is 80/443)
#
# The hostname must match the certificate's SAN when S3_USE_SSL is true.
S3_ENDPOINT=host.docker.internal:9000

# true for Ceph over HTTPS, false for local minio over plain HTTP.
# DuckDB's own default is TRUE, so this must be set explicitly for minio.
S3_USE_SSL=false

# 'path' puts the bucket in the URL path: https://host/bucket/key
# 'vhost' puts it in the hostname:        https://bucket.host/key
#
# DuckDB defaults to 'vhost'. **Verified against Ceph 19.2: vhost FAILS**, with
# `Could not resolve hostname` for https://<bucket>.<host>/ — because nothing
# resolves the bucket-prefixed name. Keep this as 'path'.
S3_URL_STYLE=path

# DuckDB requires a value for request signing. **Verified: Ceph IGNORES it** —
# a deliberately wrong region still passes every check, so a wrong region is
# never the cause of a failure. Leave it alone.
S3_REGION=us-east-1

# ------------------------------------------------------------- credentials --
# For Ceph these are the RGW user's access key and secret key.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Only for temporary/STS credentials. Leave empty otherwise.
S3_SESSION_TOKEN=

# ---------------------------------------------------------------- TLS / CA --
# For a Ceph endpoint using a private or self-signed certificate, put the CA
# bundle (PEM) somewhere the container can read and name it here. Mount it in:
#     docker run -v /path/to/ca.pem:/app/config/ca.pem:ro ...
# Leave EMPTY to use the system CA store (correct for a publicly-signed cert).
#
# Maps to DuckDB's `ca_cert_file` setting.
CA_CERT_FILE=

# Set to true ONLY to prove a TLS failure is certificate-related. This does not
# disable verification (DuckDB has no such switch) — it turns OFF SSL entirely,
# so it is a diagnostic, never a way to run the real tests.
S3_INSECURE_DIAGNOSTIC=false

# -------------------------------------------------------------- what to read -
# The bucket holding the pre-uploaded Parquet objects.
S3_BUCKET=duck-perf

# Prefix (folder) inside the bucket. Empty means the whole bucket.
# No leading slash. A trailing slash is optional.
#
# Leave EMPTY and set FIXTURE below to target one of the generated fixtures.
# An explicit S3_PREFIX always wins, so real non-fixture data still works.
S3_PREFIX=

# Which fixture scale to read: 1m, 10m, 100m, 1b or 10b.
# Resolves to the prefix v1/<scale>/. One word switches the whole harness from
# one scale to another. Unknown values are rejected by name.
# See fixtures/README.md for the layout and the sizes.
FIXTURE=

# The glob the harness queries. `**` recurses into subdirectories.
# Leave as-is unless your objects are not named *.parquet.
S3_GLOB=**/*.parquet

# ------------------------------------------------------------ http tuning ---
# Seconds. Raise if the Ceph endpoint is slow or far away; a cold wide scan on
# a loaded cluster can exceed the 30s default.
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Corporate proxy, if the test box needs one to reach Ceph. Usually empty.
HTTP_PROXY_HOST=
HTTP_PROXY_USERNAME=
HTTP_PROXY_PASSWORD=

# ----------------------------------------------------------- duckdb caches --
# ALL THREE ARE OFF IN DUCKDB BY DEFAULT and they are the single highest-value
# configuration decision for remote Parquet. Locally, turning them on took a
# two-predicate search from transferring 40.7 MB to 5 KB.
#
# The harness treats these as the DEFAULT PROFILE. `03-caches.mjs` measures both
# states regardless of what is set here, so leaving them on does not hide the
# comparison.
HTTP_METADATA_CACHE=true
PARQUET_METADATA_CACHE=true
HTTPFS_CONNECTION_CACHING=true

# DuckDB's in-memory cache of external file data. ON by default in 1.5.5.
EXTERNAL_FILE_CACHE=true

# ------------------------------------------------------------ duckdb engine -
# Set BELOW the container's memory cap. Above it, DuckDB never spills and the
# kernel kills the process instead — which reads as "DuckDB OOMs" and is not.
MEMORY_LIMIT=8GiB

# Empty = one thread per core. Capping threads is the documented mitigation for
# the wide top-N memory cliff (the requirement is threads x row_group x columns).
THREADS=

# Where DuckDB spills when a query exceeds MEMORY_LIMIT. Without this, an
# over-limit query FAILS instead of spilling to disk.
TEMP_DIRECTORY=/tmp/duckdb-spill

# ---------------------------------------------------------------- the runs --
# Timed repeats per query. The harness reports the MEDIAN and discards a warmup.
REPEATS=3

# Where result JSON is written, for scp off the box afterwards.
RESULTS_DIR=/app/results
