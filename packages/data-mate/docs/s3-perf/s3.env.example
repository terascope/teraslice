# =============================================================================
# S3 / Ceph connection + run settings for the DuckFrame performance harness.
#
# The image ships this file to /app/config/s3.env. Edit THAT copy over SSH:
#
#     docker exec -it <container> vi /app/config/s3.env
#
# or mount your own:  docker run --env-file s3.env ...
#
# Defaults below are the LOCAL MINIO settings, so the image works on the Mac
# with no edits. Change the marked block for Ceph.
#
# Every name here maps to a real DuckDB setting, verified against the 1.5.5
# build in this image. `SELECT * FROM duckdb_settings()` lists them all.
# =============================================================================

# ---------------------------------------------------------------- endpoint --
# Host and port ONLY. No scheme — DuckDB adds it based on S3_USE_SSL below.
#   local minio : 127.0.0.1:9000   (or host.docker.internal:9000 from a container)
#   ceph rgw    : rgw.your.domain  (RGW commonly listens on 8080 plain / 8443 TLS,
#                                   NOT 9000 — add the port unless it is 80/443)
#
# The hostname must match the certificate's SAN when S3_USE_SSL is true.
S3_ENDPOINT=host.docker.internal:9000

# true for Ceph over HTTPS, false for local minio over plain HTTP.
# DuckDB's own default is TRUE, so this must be set explicitly for minio.
S3_USE_SSL=false

# 'path' puts the bucket in the URL path: https://host/bucket/key
# 'vhost' puts it in the hostname:        https://bucket.host/key
#
# DuckDB defaults to 'vhost'. **Verified against Ceph 19.2: vhost FAILS**, with
# `Could not resolve hostname` for https://<bucket>.<host>/ — because nothing
# resolves the bucket-prefixed name. Keep this as 'path'.
S3_URL_STYLE=path

# DuckDB requires a value for request signing. **Verified: Ceph IGNORES it** —
# a deliberately wrong region still passes every check, so a wrong region is
# never the cause of a failure. Leave it alone.
S3_REGION=us-east-1

# ------------------------------------------------------------- credentials --
# For Ceph these are the RGW user's access key and secret key.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Only for temporary/STS credentials. Leave empty otherwise.
S3_SESSION_TOKEN=

# ---------------------------------------------------------------- TLS / CA --
# OPTIONAL. LEAVE IT EMPTY UNLESS YOU ACTUALLY HAVE A PEM TO HAND.
#
# **DO NOT DESIGN ANYTHING AROUND A CA CERTIFICATE UNLESS IT IS THE ONLY
# POSSIBLE WAY.** A CA file has to be obtained, shipped to every box, mounted
# into every container and kept in step with rotation — and none of that is
# needed to reach a private-CA endpoint.
#
# When this is EMPTY the harness sets
#     enable_curl_server_cert_verification = false
# so a private or self-signed certificate connects without a PEM. The link is
# still encrypted; the server is simply not authenticated.
#
# A PREVIOUS VERSION OF THIS COMMENT CLAIMED "DuckDB has no such switch". THAT
# WAS WRONG, and believing it turned a config default into an imagined hard
# requirement and cost a long diagnosis. Verified against DuckDB 1.5.5 —
# `duckdb_settings()` lists `enable_curl_server_cert_verification` next to
# `ca_cert_file` and `enable_server_cert_verification`. Check the setting list
# before concluding the engine cannot do something.
#
# Set this ONLY when you have the PEM and want the server authenticated too:
#     docker run -v /path/to/ca.pem:/app/config/ca.pem:ro ...
#     CA_CERT_FILE=/app/config/ca.pem
# Maps to DuckDB's `ca_cert_file`, applied with SET GLOBAL (see DF13).
CA_CERT_FILE=

# Set to true ONLY to prove a TLS failure is certificate-related. It turns OFF
# SSL entirely — plain HTTP — so it is a diagnostic, never a way to run the real
# tests. To keep TLS but skip certificate checking, leave CA_CERT_FILE empty;
# that is handled above and is the normal path.
S3_INSECURE_DIAGNOSTIC=false

# -------------------------------------------------------------- what to read -
# The bucket holding the pre-uploaded Parquet objects.
S3_BUCKET=duck-perf

# Prefix (folder) inside the bucket. Empty means the whole bucket.
# No leading slash. A trailing slash is optional.
#
# Leave EMPTY and set FIXTURE below to target one of the generated fixtures.
# An explicit S3_PREFIX always wins, so real non-fixture data still works.
S3_PREFIX=

# Which fixture scale to read: 1m, 10m, 100m, 1b or 10b.
# Resolves to the prefix v1/<scale>/. One word switches the whole harness from
# one scale to another. Unknown values are rejected by name.
# See fixtures/README.md for the layout and the sizes.
FIXTURE=

# The glob the harness queries. `**` recurses into subdirectories.
# Leave as-is unless your objects are not named *.parquet.
S3_GLOB=**/*.parquet

# ------------------------------------------------------------ http tuning ---
# Seconds. Raise if the Ceph endpoint is slow or far away; a cold wide scan on
# a loaded cluster can exceed the 30s default.
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Corporate proxy, if the test box needs one to reach Ceph. Usually empty.
HTTP_PROXY_HOST=
HTTP_PROXY_USERNAME=
HTTP_PROXY_PASSWORD=

# ----------------------------------------------------------- duckdb caches --
# ALL THREE ARE OFF IN DUCKDB BY DEFAULT and they are the single highest-value
# configuration decision for remote Parquet. Locally, turning them on took a
# two-predicate search from transferring 40.7 MB to 5 KB.
#
# The harness treats these as the DEFAULT PROFILE. `03-caches.mjs` measures both
# states regardless of what is set here, so leaving them on does not hide the
# comparison.
HTTP_METADATA_CACHE=true
PARQUET_METADATA_CACHE=true
HTTPFS_CONNECTION_CACHING=true

# DuckDB's in-memory cache of external file data. ON by default in 1.5.5, and
# NOT governed by MEMORY_LIMIT — it is the single largest avoidable term in peak
# RSS. Measured on the 100M fixture over Ceph, memory_limit 2GiB, 4 threads:
#
#   shape        cache ON    cache OFF
#   full scan      553 MiB     196 MiB   (and 2x faster)
#   wide top-N    3819 MiB     587 MiB   (6.5x less, no slower)
#
# Leave it ON when RAM is plentiful and queries repeat; turn it OFF on a small
# box. `03-caches.mjs` measures both states regardless of what is set here.
EXTERNAL_FILE_CACHE=true

# ------------------------------------------------------------ duckdb engine -
# Set BELOW the container's memory cap. Above it, DuckDB never spills and the
# kernel kills the process instead — which reads as "DuckDB OOMs" and is not.
#
# BUDGET FOR A ~3 GB FLOOR PLUS ~2x THIS NUMBER. memory_limit bounds DuckDB's
# buffer manager, NOT the process, and a process running MANY queries keeps the
# high-water mark of all of them — the allocator does not return freed pages to
# the OS. Measured, full 10-shape battery over Ceph at 100M, 4 threads, cache on:
#
#   limit      peak anon RSS    battery total   failed shapes
#   512MiB          4050 MiB         4388 ms          0
#   1GiB            5137 MiB         4475 ms          0
#   2GiB            7318 MiB         4635 ms          0
#
#   peak RSS ~= 2965 MiB + 2.13 x memory_limit      (predicts 7327 at 2GiB)
#
# The ~3 GB intercept is the floor: node, DuckDB, the external file cache and
# allocator retention. No limit reaches it — only EXTERNAL_FILE_CACHE=false does,
# and that costs 3.7x on the battery. Two consequences:
#
#   1. SHRINKING THE LIMIT IS FREE. 512MiB was the FASTEST of the three. These
#      shapes stream and spill; they do not need a large pool.
#   2. A SINGLE-QUERY MEASUREMENT UNDERSTATES THIS. One query lands near 1.9x the
#      limit; ten in one process reach 3.6x. Size from a full run, never one query.
#
# For an 8 GB box: 1GiB gives ~5.1 GB peak, leaving ~2.9 GB. Do not exceed 1GiB
# there. The old 8GiB default predicts ~20 GB and was OOM-killed twice.
MEMORY_LIMIT=1GiB

# Empty = one thread per core. Capping threads is the documented mitigation for
# the wide top-N memory cliff (the requirement is threads x row_group x columns).
THREADS=

# Where DuckDB spills when a query exceeds MEMORY_LIMIT. Without this, an
# over-limit query FAILS instead of spilling to disk.
TEMP_DIRECTORY=/tmp/duckdb-spill

# Cap on that spill. DuckDB's default is 90% OF AVAILABLE DISK, so on a box with
# little free space a spilling query can fill the filesystem before it fails.
#
# NOTE THE TENSION: lowering MEMORY_LIMIT is the fix for peak RSS, and it makes
# spilling MORE likely. On a box that is short of BOTH memory and disk the two
# settings must be chosen together — too high a limit is OOM-killed, too low a
# limit spills onto a disk that is not there. Setting this converts "the disk
# filled up" into a clean query error naming the limit.
# Empty = DuckDB's default.
MAX_TEMP_DIRECTORY_SIZE=

# Drain every row of the frame into JS in the duckframe step. This is ROW
# performance, not query performance: at 100M it took 1,261,310 ms — 21 minutes,
# two orders of magnitude above every other shape — and the worker never does it
# (it writes Parquet or aggregates). OFF by default.
DRAIN_ALL_ROWS=false

# ---------------------------------------------------------------- the runs --
# WARM repeats per query. The harness reports the MEDIAN and discards a warmup,
# and the cold first touch runs on top of both — so N here means 1 + 1 + N
# executions, not N. In `./run.sh sql` only, 0 means "the cold run and nothing
# else"; every other script clamps it to 1, because a median needs a sample.
REPEATS=3

# Where result JSON is written, for scp off the box afterwards.
RESULTS_DIR=/app/results
