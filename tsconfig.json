{
    "compilerOptions": {
        "moduleResolution": "nodenext",
        "target": "ESNext",
        "module": "nodenext",
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "strict": true,
        "useUnknownInCatchVariables": false,
        "noFallthroughCasesInSwitch": true,
        "preserveConstEnums": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "ignoreDeprecations": "5.0",
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "isolatedModules": true,
        "disableReferencedProjectLoad": true,
        "types": ["node", "jest"],
        "typeRoots": [
            "./types",
            "./node_modules/@types"
        ],
        "paths": {
            "*": [
                "./types/*/index.d.ts"
            ],
            "is-plain-object": [
                "./packages/core-utils/node_modules/is-plain-object/is-plain-object.d.ts"
            ],
            "@opensearch-project/opensearch": [
                "./packages/elasticsearch-api/node_modules/@opensearch-project/opensearch/index.d.ts"
            ],
            "opensearch1": [
                "./packages/opensearch-client/node_modules/opensearch1/index.d.ts"
            ]
        }
    },
    "include": [],
    "exclude": [
        "**/node_modules",
        "**/.*/",
        "**/build/**/*"
    ],
    "references": [
        {
            "path": "packages/docker-compose-js"
        },
        {
            "path": "packages/types"
        },
        {
            "path": "packages/core-utils"
        },
        {
            "path": "packages/ip-utils"
        },
        {
            "path": "packages/geo-utils"
        },
        {
            "path": "packages/data-types"
        },
        {
            "path": "packages/xlucene-parser"
        },
        {
            "path": "packages/data-mate"
        },
        {
            "path": "packages/opensearch-client"
        },
        {
            "path": "packages/xlucene-translator"
        },
         {
            "path": "packages/elasticsearch-api"
        },
        {
            "path": "packages/elasticsearch-store"
        },
        {
            "path": "packages/job-components"
        },
        {
            "path": "packages/scripts"
        },
        {
            "path": "packages/terafoundation"
        },
        {
            "path": "packages/teraslice-messaging"
        },
        {
            "path": "packages/teraslice"
        },
        {
            "path": "packages/teraslice-client-js"
        },
        {
            "path": "packages/teraslice-cli"
        },
        {
            "path": "packages/teraslice-state-storage"
        },
        {
            "path": "packages/teraslice-test-harness"
        },
        {
            "path": "packages/ts-transforms"
        },
        {
            "path": "packages/valkey"
        },
        {
            "path": "packages/xpressions"
        }
    ]
}
